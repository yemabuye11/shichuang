# ---------------------------------------------------------------------------
# 师创（shichuang）· 前端环境变量样例
# 复制为 .env.local 后填写。切勿把 .env.local 提交到版本库。
#
# ⚠️ 安全红线：前端只能出现 URL 与 anon key。
#    任何大模型 API Key、service_role key 只能配置在 Supabase Edge Function
#    的 secrets 里（见本文件「二、Edge Function 侧密钥」）。
# ---------------------------------------------------------------------------

# 一、前端（Vite，会被打进产物，必须是不敏感值）

# Supabase 项目地址，形如 https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=
# Supabase anon public key（可公开，受 RLS 保护）
VITE_SUPABASE_ANON_KEY=

# 品牌（可选；不填则使用 src/config/brand.ts 的默认值「师创」）
VITE_BRAND_NAME=师创
VITE_BRAND_SLOGAN=一句话，做出你的教学应用
VITE_BRAND_LOGO=/icons/icon.svg
VITE_PUBLIC_DOMAIN=

# 无后端联调模式（MOCK）：true 时即使没有 Supabase 配置也能跑通
# 「输入 → 流式生成 → 预览 → 扣积分」全链路。生产环境务必删除或置为 false。
VITE_ENABLE_MOCK=false


# 二、Edge Function 侧密钥（Deno 运行时，通过 supabase secrets set 注入，
#     绝不能带 VITE_ 前缀，否则会被打进前端产物）
#
#   supabase secrets set DEEPSEEK_API_KEY=sk-xxxxx
#   supabase secrets set QWEN_API_KEY=sk-xxxxx
#   supabase secrets set GLM_API_KEY=xxxxx
#   supabase secrets set DOUBAO_API_KEY=xxxxx
#
#   # 浏览去重哈希盐（必填，任意长随机串；更换后历史去重记录失效）
#   supabase secrets set SECRET_SALT=please-change-me
#
#   # 回源兜底用的 GitHub Pages 写入凭据（artifact.provider=github_pages 时必填）
#   supabase secrets set GITHUB_PAGES_TOKEN=github_pat_xxxxx
#   supabase secrets set GITHUB_PAGES_REPO=owner/repo
#   supabase secrets set GITHUB_PAGES_BRANCH=main
#
#   # Cloudflare R2（artifact.provider=r2 时必填）
#   supabase secrets set R2_ACCOUNT_ID=xxxxx
#   supabase secrets set R2_ACCESS_KEY_ID=xxxxx
#   supabase secrets set R2_SECRET_ACCESS_KEY=xxxxx
#   supabase secrets set R2_BUCKET=shichuang-apps
#   supabase secrets set R2_PUBLIC_BASE_URL=https://apps.example.com
#
# 说明：SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY 由平台自动注入，无需手动设置。
# 未配置任何一家大模型 Key 时，LlmAdapter 会自动降级为 MockAdapter，
# 返回一份完整可运行的示例教学应用 HTML，并在控制台打印醒目提示。
